{
  "extends": ["adpyke-es6", "prettier"],
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "globals": {
    "ClipboardItem": true,
    "snapdom": true,
    "domtoimage": true
  },
  "env": {
    "browser": false,
    "node": true
  },
  "overrides": [
    {
      "files": ["test/*.spec.js", "benchmark/*.js"],
      "env": {
        "browser": true
      }
    }
  ]
}
