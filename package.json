{
  "name": "codesnap-next-chumeng",
  "displayName": "CodeSnap Next",
  "description": "Code screenshots with cached PNG rendering and native Windows / Wayland clipboard support.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lihaoze123/codesnap-next"
  },
  "publisher": "chumeng",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.52.0"
  },
  "keywords": [
    "screenshot",
    "snippet",
    "snap",
    "clipboard",
    "share",
    "polacode",
    "carbon",
    "codesnap"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codesnapNext.start"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codesnapNext.start",
        "title": "CodeSnap Next 📸"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codesnapNext.start"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "CodeSnap Next",
      "properties": {
        "codesnapNext.backgroundColor": {
          "scope": "resource",
          "type": "string",
          "default": "#abb8c3",
          "description": "The background color of the snippet's container"
        },
        "codesnapNext.boxShadow": {
          "scope": "resource",
          "type": "string",
          "default": "rgba(0, 0, 0, 0.55) 0px 20px 68px",
          "description": "The CSS box-shadow for the snippet"
        },
        "codesnapNext.containerPadding": {
          "scope": "resource",
          "type": "string",
          "default": "3em",
          "description": "The padding for the snippet's container"
        },
        "codesnapNext.roundedCorners": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Use rounded corners for the window"
        },
        "codesnapNext.showWindowControls": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Display OS X style window controls"
        },
        "codesnapNext.showWindowTitle": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Display window title with open folder / file name"
        },
        "codesnapNext.showLineNumbers": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Display line numbers"
        },
        "codesnapNext.realLineNumbers": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Start from the selection's line number instead of 1"
        },
        "codesnapNext.transparentBackground": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Use a transparent background when taking the screenshot"
        },
        "codesnapNext.target": {
          "scope": "resource",
          "type": "string",
          "enum": [
            "container",
            "window"
          ],
          "default": "container",
          "description": "Take the shot with or without the container"
        },
        "codesnapNext.shutterAction": {
          "scope": "resource",
          "type": "string",
          "enum": [
            "save",
            "copy"
          ],
          "default": "save",
          "description": "The behavior of the shutter button"
        },
        "codesnapNext.clipboardMode": {
          "scope": "resource",
          "type": "string",
          "enum": [
            "auto",
            "browser"
          ],
          "default": "auto",
          "description": "Clipboard backend: auto uses native copying on Windows and falls back to wl-copy on Wayland; browser uses only the Webview clipboard."
        },
        "codesnapNext.showTiming": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Show preparation and clipboard timings after a successful copy."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,md,json,css,prettierrc,eslintrc,html}\"",
    "check:format": "prettier --check \"**/*.{js,jsx,md,json,css,prettierrc,eslintrc,html}\"",
    "check": "npm run lint && npm run check:format",
    "test": "node --test test/*.test.js && playwright test",
    "benchmark": "node benchmark/run.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.2.2",
    "@types/node": "^14.14.40",
    "@types/vscode": "^1.52.0",
    "dom-to-image-even-more": "1.0.4",
    "eslint": "^7.24.0",
    "eslint-config-adpyke-es6": "^1.4.13",
    "eslint-config-prettier": "^8.2.0",
    "glob": "^7.1.6",
    "mocha": "^8.3.2",
    "prettier": "^2.2.1",
    "typescript": "^4.2.4",
    "vscode-test": "^1.5.2"
  },
  "dependencies": {
    "@zumer/snapdom": "3.3.6"
  },
  "homepage": "https://github.com/lihaoze123/codesnap-next",
  "bugs": {
    "url": "https://github.com/lihaoze123/codesnap-next/issues"
  }
}
